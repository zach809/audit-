# Vercel/Neon
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Clio OAuth app
CLIO_CLIENT_ID=""
CLIO_CLIENT_SECRET=""
CLIO_REDIRECT_URI="https://your-vercel-app.vercel.app/api/auth/clio/callback"
CLIO_BASE_URL="https://app.clio.com"

# App security
DASHBOARD_PASSWORD="change-this"
CASE_MANAGER_USERS="zach@hirschlawgroup.com:Hirsch12345678,ivan@hirschlawgroup.com:Hirsch12345678,ronald@hirschlawgroup.com:Hirsch12345678,svetlana@hirschlawgroup.com:Hirsch12345678,claudia@hirschlawgroup.com:Hirsch12345678,anahi@hirschlawgroup.com:Hirsch12345678,nathaly@hirschlawgroup.com:Hirsch12345678,lori@hirschlawgroup.com:Hirsch12345678,jesus@hirschlawgroup.com:Hirsch12345678,alessandra@hirschlawgroup.com:Hirsch12345678,camila@hirschlawgroup.com:Hirsch12345678"
SESSION_SECRET="generate-a-long-random-secret"
TOKEN_ENCRYPTION_KEY="generate-a-32-byte-base64-key"
CRON_SECRET="generate-a-long-random-secret"

# Local next dev only (VERCEL_ENV unset). Ignored on Vercel preview/development.
CWCA_ALLOW_WRITES="1"

# Audit behavior
AUDIT_BATCH_SIZE="10"
AUDIT_COOLDOWN_SECONDS="30"
CLIO_INITIAL_LOOKBACK_DAYS="90"
CLIO_RATE_LIMIT_PER_MINUTE="40"
AUDIT_RUN_RETENTION_DAYS="90"
AUDIT_METRIC_RETENTION_DAYS="365"
CLOSED_MATTER_RETENTION_DAYS="30"

# Optional manual AI helper
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Optional live Google Sheets Standards sync
# Share the Google Sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Optional live Microsoft Excel Online Standards sync
# Delegated: set MICROSOFT_EXCEL_REFRESH_TOKEN (public client; secret is not sent).
# Application: omit the refresh token and set MICROSOFT_CLIENT_SECRET.
# The template and the month workbooks must live in the same folder: Graph copies
# the template into the template's own folder.
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_EXCEL_REFRESH_TOKEN=""
MICROSOFT_EXCEL_USER_ID="zach@hirschlawgroup.com"
MICROSOFT_EXCEL_TEMPLATE_PATH="CWCA/Standards Template.xlsx"
MICROSOFT_EXCEL_WORKBOOK_PATH="CWCA/Standards {month}.xlsx"
MICROSOFT_EXCEL_WORKBOOK_WEB_URL=""

# Vercel PREVIEW environment only. Never set these on Production.
# A preview deployment inherits the production variables above, so the Excel
# sync ignores MICROSOFT_EXCEL_WORKBOOK_PATH when VERCEL_ENV is preview and
# reads the _PREVIEW one instead. Unset, the sync refuses; it never falls back
# to the production workbook. The template is shared and Graph copies it into
# its own folder, so the preview path names another file in that same folder.
# Set the opt-in to 1 or true to let /api/standards/excel-sync run on preview.
CWCA_ALLOW_PREVIEW_EXCEL_SYNC=""
MICROSOFT_EXCEL_WORKBOOK_PATH_PREVIEW="CWCA/cwca-standards-test {month}.xlsx"
MICROSOFT_EXCEL_WORKBOOK_WEB_URL_PREVIEW=""
