# Vercel Cron protection
CRON_SECRET=replace-me-with-a-long-random-value

# Clio OAuth / API
CLIO_CLIENT_ID=replace-me
CLIO_CLIENT_SECRET=replace-me
CLIO_REDIRECT_URI=https://your-domain.vercel.app/api/auth/clio/callback
CLIO_API_BASE_URL=https://app.clio.com/api/v4
CLIO_REGION=US

# Database
POSTGRES_URL=postgres://user:password@host:5432/cwca

# Token encryption. Use a 32-byte base64 key.
TOKEN_ENCRYPTION_KEY=replace-me
